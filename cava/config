## cava config — macOS + BlackHole 2ch

[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = portaudio
source = BlackHole 2ch

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0

[smoothing]
noise_reduction = 77

[color]
# Catppuccin Mocha — no background/foreground so kitty opacity shows through
gradient = 1
gradient_count = 8
gradient_color_1 = '#94e2d5'  # teal
gradient_color_2 = '#89dceb'  # sky
gradient_color_3 = '#74c7ec'  # sapphire
gradient_color_4 = '#89b4fa'  # blue
gradient_color_5 = '#cba6f7'  # mauve
gradient_color_6 = '#f5c2e7'  # pink
gradient_color_7 = '#eba0ac'  # maroon
gradient_color_8 = '#f38ba8'  # red
