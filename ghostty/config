# Font — see FONTS.md for download links and variant notes.
# MUST be a Nerd Font: starship, `eza --icons` and the tmux status bar all draw
# powerline/icon glyphs that plain JetBrains Mono lacks (they render as tofu).
#   brew install --cask font-jetbrains-mono-nerd-font
# Family name is exact: no space inside "JetBrainsMono", space before "Nerd Font".
# Ghostty falls back silently on a typo, so tofu glyphs => check this line first.
# This is the single source of truth — nvim/tmux/starship inherit it.
font-family = JetBrainsMono Nerd Font
font-size = 15

# Window
window-padding-x = 8
window-padding-y = 0

# Split the leftover pixels (window height rarely divides evenly by cell
# height) across top and bottom instead of pooling them all under the last
# row, which otherwise reads as a gap beneath the status bar.
window-padding-balance = true
window-decoration = false
macos-titlebar-style = hidden

# Non-native fullscreen: skips the macOS space-switch animation and hides
# the menu bar. Note: this does NOT reach into the notch row — AppKit lays
# windows out inside the screen's safe area and Ghostty 1.3.1 has no option
# to opt out of it.
macos-non-native-fullscreen = true

# Background
background-opacity = 0.80
background-blur = 20
unfocused-split-opacity = 0.9

# Theme — follows macOS appearance (light: Latte, dark: Mocha)
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Cursor
cursor-style = bar

# Mouse — hold Shift to bypass tmux mouse capture for links/selection
mouse-shift-capture = always

# macOS
macos-option-as-alt = true
